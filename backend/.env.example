# Ortam: development | production
ENV=development

# Virgülle ayrılmış, izin verilen frontend origin listesi (CORS)
CORS_ORIGINS=http://localhost:3000

# Yükleme boyutu limiti (MB) ve geçici dosya ömrü
MAX_TOTAL_UPLOAD_MB=50
FILE_TTL_MINUTES=60
CLEANUP_INTERVAL_MINUTES=10

# IP başına, endpoint başına dakikada izin verilen istek sayısı
RATE_LIMIT_PER_MINUTE=10

# Loglama
LOG_LEVEL=INFO
LOG_JSON=true
