# AtlasPDF için örnek Caddyfile.
# your-domain.com yerine gerçek domain'inizi yazın.
# Caddy, SSL sertifikalarını (Let's Encrypt) otomatik olarak alır ve yeniler
# — ayrı bir `tls` bloğu veya certbot kurulumu gerekmez.

your-domain.com {
    encode gzip

    handle_path /api/* {
        request_body {
            # Backend'deki MAX_TOTAL_UPLOAD_MB (varsayılan 50) ile uyumlu, biraz payla
            max_size 55MB
        }
        reverse_proxy 127.0.0.1:8000
    }

    handle {
        reverse_proxy 127.0.0.1:3000
    }
}

# Not: Nginx örneğindeki X-Forwarded-For / rate-limit caveat'i burada da geçerli.
